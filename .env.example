# ─────────────────────────────────────────────
#  AutomatedBot Dashboard — Environment Variables
# ─────────────────────────────────────────────

# REQUIRED: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# REQUIRED: Secret for signing sessions (any long random string)
SESSION_SECRET=change_me_to_a_long_random_secret_string

# Server port (default: 8080 for dev, set by platform in prod)
PORT=8080

# Set to "production" when deploying
NODE_ENV=development
